@inproceedings{kimIntelligentMazeGeneration2018,
  title = {Intelligent {{Maze Generation Based}} on {{Topological Constraints}}},
  booktitle = {2018 7th {{International Congress}} on {{Advanced Applied Informatics}} ({{IIAI-AAI}})},
  author = {Kim, Paul Hyunjin and Crawfis, Roger},
  year = 2018,
  month = jul,
  pages = {867--872},
  doi = {10.1109/IIAI-AAI.2018.00176},
  urldate = {2026-02-16},
  abstract = {Maze is a puzzle, in which players need to find a path from an entrance to a goal on the maze. Although maze is a puzzle itself, it is also used as a tool in different fields, such as computer game and robotics. Since maze users in different fields may have different purposes of using a maze, different desired properties may be wanted on the maze. This paper provides a method which generates the desired maze when users give desired properties. Our method uses search-based procedural content generation (SBPCG) approach, in which the process repeatedly generate-and-test mazes to obtain a satisfactory maze. Our research focuses on a perfect maze, and existing perfect maze generation algorithms can be used in the SBPCG approach. When the algorithms are used, to obtain a desired maze with a higher probability, our method chooses the best algorithm amongst intelligently. Lastly, we provide several use cases and demonstrate that our method generates desired mazes effectively for each use case.},
  keywords = {Computer science,Games,Junctions,Measurement,perfect maze maze generation algorithm search-based procedural content generation,Robots,Shape,Topology},
  file = {/home/laner/Zotero/storage/46ANSVYC/Kim and Crawfis - 2018 - Intelligent Maze Generation Based on Topological Constraints.pdf}
}

@inproceedings{kimQuestPerfectPerfectmaze2015,
  title = {The Quest for the Perfect Perfect-Maze},
  booktitle = {2015 {{Computer Games}}: {{AI}}, {{Animation}}, {{Mobile}}, {{Multimedia}}, {{Educational}} and {{Serious Games}} ({{CGAMES}})},
  author = {Kim, Paul Hyunjin and Crawfis, Roger},
  year = 2015,
  month = jul,
  pages = {65--72},
  doi = {10.1109/CGames.2015.7272964},
  urldate = {2026-02-16},
  abstract = {In this paper, the quest for the perfect perfect-maze is performed over the search space of perfect mazes using an approach of search-based procedural content generation. Perfect maze construction is rather random with little to no control of the final product. We propose a search-based framework based on attributes or metrics of a constructed maze to provide a foundation for evaluation functions (fitness functions). Since the meaning of ``perfect'' is subjective and different for every designer, we allow designers to construct their own evaluation function to generate the best maze. We have also analyzed each metric's space on an exhaustive enumeration of small-sized mazes to determine allowable, and perhaps desirable, ranges for each metric. Using these metrics, an evaluation function is constructed to search for the ``best'' maze.},
  keywords = {Game level design,Maze evaluation,Measurement,Procedural content generation,Search-based procedural content generation},
  file = {/home/laner/Zotero/storage/QJABWD8T/Kim and Crawfis - 2015 - The quest for the perfect perfect-maze.pdf}
}

