@inproceedings{vijaya_analysis_2024,
	title = {Analysis of {Maze} {Generation} {Algorithms}},
	url = {https://ieeexplore.ieee.org/document/10580178},
	doi = {10.1109/ICITIIT61487.2024.10580178},
	abstract = {Procedural content generation plays a crucial role in modern game development, offering efficient methods for creating intricate mazes, a prime example of its utility. However, when it comes to homemade maze generation, there’s often a limitation in providing the necessary diversity of mazes to maintain player engagement. Predictability can creep in, diminishing the player’s experience. In this composition, we embark on a comprehensive exploration of three introductory 2-D maze-generation algorithms, firstly, DFS (Depth-First Search), secondly, Recursive description, and lastly Prim’s-Method algorithm. Rather than merely analyzing these algorithms, our focus is on addressing their inherent drawbacks. Specifically, we aim to find solutions to enhance their utility in game development, particularly in terms of improving path lengths and increasing the diversity of generated mazes. In essence, procedural content generation, as exemplified by maze generation algorithms, serves as an indispensable tool for game designers seeking not only to understand the limitations but also to find creative solutions that strike a balance between generating engaging content and maintaining gameplay diversity.},
	urldate = {2026-02-16},
	booktitle = {2024 5th {International} {Conference} on {Innovative} {Trends} in {Information} {Technology} ({ICITIIT})},
	author = {Vijaya, J. and Gopu, Arunkumar and Vinayak, K V S G and Singh, Thakur Jaideep and Malhotra, Kanika},
	month = mar,
	year = {2024},
	keywords = {Complexity theory, Depth First Hunt, Layout, Market research, Measurement, Prediction algorithms, Prim’s Algorithm, Procedural content generation, Procedural generation, Recursive description, Scalability},
	pages = {1--6},
	file = {Full Text PDF:/home/laner/Zotero/storage/L7YCZFU3/Vijaya et al. - 2024 - Analysis of Maze Generation Algorithms.pdf:application/pdf},
}

@inproceedings{kim_intelligent_2018,
	title = {Intelligent {Maze} {Generation} {Based} on {Topological} {Constraints}},
	url = {https://ieeexplore.ieee.org/document/8693301},
	doi = {10.1109/IIAI-AAI.2018.00176},
	abstract = {Maze is a puzzle, in which players need to find a path from an entrance to a goal on the maze. Although maze is a puzzle itself, it is also used as a tool in different fields, such as computer game and robotics. Since maze users in different fields may have different purposes of using a maze, different desired properties may be wanted on the maze. This paper provides a method which generates the desired maze when users give desired properties. Our method uses search-based procedural content generation (SBPCG) approach, in which the process repeatedly generate-and-test mazes to obtain a satisfactory maze. Our research focuses on a perfect maze, and existing perfect maze generation algorithms can be used in the SBPCG approach. When the algorithms are used, to obtain a desired maze with a higher probability, our method chooses the best algorithm amongst intelligently. Lastly, we provide several use cases and demonstrate that our method generates desired mazes effectively for each use case.},
	urldate = {2026-02-16},
	booktitle = {2018 7th {International} {Congress} on {Advanced} {Applied} {Informatics} ({IIAI}-{AAI})},
	author = {Kim, Paul Hyunjin and Crawfis, Roger},
	month = jul,
	year = {2018},
	keywords = {Measurement, Computer science, Games, Junctions, perfect maze, maze generation algorithm, search-based procedural content generation, Robots, Shape, Topology},
	pages = {867--872},
	file = {Full Text PDF:/home/laner/Zotero/storage/46ANSVYC/Kim and Crawfis - 2018 - Intelligent Maze Generation Based on Topological Constraints.pdf:application/pdf},
}

@inproceedings{kim_quest_2015,
	title = {The quest for the perfect perfect-maze},
	url = {https://ieeexplore.ieee.org/document/7272964},
	doi = {10.1109/CGames.2015.7272964},
	abstract = {In this paper, the quest for the perfect perfect-maze is performed over the search space of perfect mazes using an approach of search-based procedural content generation. Perfect maze construction is rather random with little to no control of the final product. We propose a search-based framework based on attributes or metrics of a constructed maze to provide a foundation for evaluation functions (fitness functions). Since the meaning of “perfect” is subjective and different for every designer, we allow designers to construct their own evaluation function to generate the best maze. We have also analyzed each metric's space on an exhaustive enumeration of small-sized mazes to determine allowable, and perhaps desirable, ranges for each metric. Using these metrics, an evaluation function is constructed to search for the “best” maze.},
	urldate = {2026-02-16},
	booktitle = {2015 {Computer} {Games}: {AI}, {Animation}, {Mobile}, {Multimedia}, {Educational} and {Serious} {Games} ({CGAMES})},
	author = {Kim, Paul Hyunjin and Crawfis, Roger},
	month = jul,
	year = {2015},
	keywords = {Measurement, Procedural content generation, Game level design, Maze evaluation, Search-based procedural content generation},
	pages = {65--72},
	file = {Full Text PDF:/home/laner/Zotero/storage/QJABWD8T/Kim and Crawfis - 2015 - The quest for the perfect perfect-maze.pdf:application/pdf},
}

